<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Admin Rate Manager</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-white p-6">
    <div class="max-w-md mx-auto bg-slate-800 p-6 rounded-xl border border-slate-700">
        <h1 class="text-lg font-bold text-emerald-400 mb-4">🚜 Rohtas Logistics Admin</h1>
        <form class="space-y-3 text-xs">
            <label>10mm Gitti Base Rate (₹/Ton):</label>
            <input type="number" id="r1" class="w-full bg-slate-700 p-2 rounded text-white">
            <label>Banaras Freight (₹/Ton):</label>
            <input type="number" id="r2" class="w-full bg-slate-700 p-2 rounded text-white">
            <button type="button" onclick="save()" class="w-full bg-emerald-600 py-2 rounded font-bold mt-2">Save Rates</button>
        </form>
    </div>
    <script>
        async function save() {
            await fetch('/api/rates/update', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({
                    materials: { "10mm_pink": { name: "10mm Pink Gitti", baseRate: Number(document.getElementById('r1').value) } },
                    freight: { "banaras": { name: "Banaras", costPerTon: Number(document.getElementById('r2').value) } }
                })
            });
            alert('Saved successfully!');
        }
    </script>
</body>
</html>
